{"_id": "68f593c5cef95f94b808b60c", "id": "dleemiller/FineCat-NLI", "author": "dleemiller", "sha": "676055f06a2ee2f67c1551e738a3e45ab1a12cfa", "lastModified": "2025-10-30T19:51:23.000Z", "private": false, "gated": false, "disabled": false, "tags": ["task_categories:feature-extraction", "task_categories:sentence-similarity", "multilinguality:monolingual", "language:en", "license:cc-by-nc-4.0", "size_categories:1M<n<10M", "format:parquet", "modality:tabular", "modality:text", "library:datasets", "library:pandas", "library:mlcroissant", "library:polars", "arxiv:2203.12942", "region:us", "sentence-transformers"], "description": "\n\t\n\t\t\n\t\n\t\n\t\tFine Concatenation (FineCat) NLI\n\t\n\n\n  \n\n\n\n\n\t\n\t\t\n\t\n\t\n\t\tOverview\n\t\n\nA common criticism of SNLI and MNLI datasets is that there are too many 'easy' samples.\nThis tends to overfit to simple / trivial patterns that don't generalize well.\nIn order to combat this, I concatenated 7 datasets (2.6M samples), then ran a\ntraining test for 50k steps with ModernBERT-large in cross-encoder configuration.\nI found that 1 dataset (~100k samples) did not have good compatibility with the labels of\u2026 See the full description on the dataset page: https://huggingface.co/datasets/dleemiller/FineCat-NLI.", "downloads": 56, "likes": 3, "cardData": {"license": "cc-by-nc-4.0", "language": ["en"], "multilinguality": ["monolingual"], "size_categories": ["1M<n<10M"], "task_categories": ["feature-extraction", "sentence-similarity"], "pretty_name": "FineCatNLI", "tags": ["sentence-transformers"], "configs": [{"config_name": "default", "data_files": [{"split": "train", "path": "splits/train*"}, {"split": "test", "path": "splits/test*"}, {"split": "validation", "path": "splits/validation*"}], "features": [{"name": "premise", "dtype": "string"}, {"name": "hypothesis", "dtype": "string"}, {"name": "label", "dtype": {"class_label": {"names": {"0": "entailment", "1": "neutral", "2": "contradiction"}}}}, {"name": "source", "dtype": "string"}, {"name": "token_count", "dtype": "int64"}, {"name": "hash", "dtype": "string"}]}, {"config_name": "distill", "data_files": [{"split": "train", "path": "distill/train*"}, {"split": "validation", "path": "distill/validation*"}, {"split": "test", "path": "distill/test*"}]}, {"config_name": "distill2", "data_files": [{"split": "train", "path": "distill2/train*"}, {"split": "validation", "path": "distill2/validation*"}, {"split": "test", "path": "distill2/test*"}]}, {"config_name": "judge", "data_files": [{"split": "filtered", "path": "judge/judge_results*"}]}]}, "siblings": [{"rfilename": ".gitattributes"}, {"rfilename": "README.md"}, {"rfilename": "distill/test.parquet"}, {"rfilename": "distill/train.parquet"}, {"rfilename": "distill/validation.parquet"}, {"rfilename": "distill2/test.parquet"}, {"rfilename": "distill2/train.parquet"}, {"rfilename": "distill2/validation.parquet"}, {"rfilename": "judge/judge_results.parquet"}, {"rfilename": "splits/test.parquet"}, {"rfilename": "splits/train.parquet"}, {"rfilename": "splits/validation.parquet"}], "createdAt": "2025-10-20T01:43:33.000Z", "usedStorage": 2664787198}