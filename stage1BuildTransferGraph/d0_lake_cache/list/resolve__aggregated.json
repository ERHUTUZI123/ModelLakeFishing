[{"_id": "62b97104270f6cf90ec9e34a", "id": "pfin123/hindi-aggregated", "author": "pfin123", "disabled": false, "gated": false, "lastModified": "2022-07-05T10:06:36.000Z", "likes": 2, "trendingScore": 0, "private": false, "sha": "f717035e2e770ba73862314f470b82c64de89bd9", "downloads": 22, "tags": ["license:apache-2.0", "size_categories:100K<n<1M", "format:json", "modality:text", "library:datasets", "library:dask", "library:mlcroissant", "library:polars", "region:us"], "createdAt": "2022-06-27T08:57:40.000Z", "key": ""}, {"_id": "633261a66eae0bb0a01fbbd2", "id": "tcsenpai/aggregated_captcha_images_and_text", "author": "tcsenpai", "disabled": false, "gated": false, "lastModified": "2022-09-27T03:31:17.000Z", "likes": 0, "trendingScore": 0, "private": false, "sha": "5bf51cd1b371b4c8aa0fe48d64123e20b25cdaf7", "description": "\n\t\n\t\t\n\t\tAggregated Captcha Images and Text\n\t\n\n\n\t\n\t\t\n\t\tCredits\n\t\n\nAll the images (not the texts) here contained have been downloaded and selected from various datasets on kaggle.com\n\n\t\n\t\t\n\t\tWhat is this?\n\t\n\nThis is a dataset containing some hundreds of thousands of images taken from real and used captchas (reCaptcha, hCaptcha and various others) and containing an equally big amount of random 4-8 length texts generated each one in 363 different fonts and with different random noise, size, colors\u2026 See the full description on the dataset page: https://huggingface.co/datasets/tcsenpai/aggregated_captcha_images_and_text.", "downloads": 9, "tags": ["license:cc-by-nc-4.0", "region:us"], "createdAt": "2022-09-27T02:36:22.000Z", "key": ""}, {"_id": "64b155aff460afaefcfe4244", "id": "gryffindor-ISWS/aggregated_metrics", "author": "gryffindor-ISWS", "disabled": false, "gated": false, "lastModified": "2023-07-14T14:08:09.000Z", "likes": 0, "trendingScore": 0, "private": false, "sha": "50bdaaa1837293d8558706ef804e29b628143740", "downloads": 6, "tags": ["license:gpl-3.0", "region:us"], "createdAt": "2023-07-14T14:03:27.000Z", "key": ""}, {"_id": "65ba500da3795ff2054a6990", "id": "mastergopote44/Long-Term-Care-Aggregated-Data", "author": "mastergopote44", "disabled": false, "gated": false, "lastModified": "2024-03-04T05:16:37.000Z", "likes": 17, "trendingScore": 0, "private": false, "sha": "53ddf9e4cc1b0a9cb921c8ae1a1e94fc033a0652", "description": "\n\t\n\t\t\n\t\tProject 1 Proposal of the Long Term Care(LTC) Aggregated Dataset\n\t\n\nKAO, HSUAN-CHEN(Justin)   \nNetID: hk310\n\n\t\n\t\t\n\t\tDataset Details\n\t\n\nThe long-term care aggregated dataset, essential for conducting experience studies, is an extensive and valuable compilation of variables central to the analysis and prediction of long-term care (LTC) insurance products. This dataset integrates two critical files: one detailing claim incidence and the other capturing policy terminations. This merger is\u2026 See the full description on the dataset page: https://huggingface.co/datasets/mastergopote44/Long-Term-Care-Aggregated-Data.", "downloads": 37, "tags": ["task_categories:feature-extraction", "task_categories:summarization", "language:en", "license:apache-2.0", "size_categories:1M<n<10M", "format:parquet", "modality:tabular", "modality:text", "library:datasets", "library:pandas", "library:mlcroissant", "library:polars", "region:us", "Actuarial Science", "LTC Products", "Underwriting", "Insurance", "Categorical Variable", "Panel Data", "SOA(LTC)"], "createdAt": "2024-01-31T13:50:05.000Z", "key": ""}, {"_id": "65eda0f24f8aa96f64980579", "id": "daveydhruti/cidds-aggregated", "author": "daveydhruti", "disabled": false, "gated": false, "lastModified": "2024-03-10T12:03:11.000Z", "likes": 0, "trendingScore": 0, "private": false, "sha": "eba9bc686269d2f00194e4943be714aaa36bfbe1", "downloads": 20, "tags": ["size_categories:10K<n<100K", "format:csv", "modality:tabular", "modality:text", "library:datasets", "library:pandas", "library:polars", "library:mlcroissant", "region:us"], "createdAt": "2024-03-10T12:00:50.000Z", "key": ""}, {