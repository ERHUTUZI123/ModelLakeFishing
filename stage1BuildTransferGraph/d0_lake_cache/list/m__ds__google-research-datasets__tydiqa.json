5\u0627 \u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0630\u0631\u064a \u0644\u0644\u0647\u064a\u062f\u0631\u0648\u062c\u064a\u0646 \u061f", "context": "\u0627\u0644\u0647\u064a\u062f\u0631\u0648\u062c\u064a\u0646 \u0647\u0648 \u0639\u0646\u0635\u0631 \u0643\u064a\u0645\u064a\u0627\u0626\u064a \u0639\u062f\u062f\u0647 \u0627\u0644\u0630\u0631\u064a 1 \u060c \u0648\u0647\u0648 \u063a\u0627\u0632 \u0639\u062f\u064a\u0645 \u0627\u0644\u0631\u0627\u0626\u062d\u0629 \u0648\u0627\u0644\u0644\u0648\u0646 \u0648\u0647\u0648 \u0633\u0631\u064a\u0639 \u0627\u0644\u0627\u0634\u062a\u0639\u0627\u0644"}, {"text": "\u0645\u0646 \u0647\u0648 \u0623\u062d\u0645\u062f \u0645\u0627\u0632\u0646 \u0623\u062d\u0645\u062f \u0623\u0633\u0639\u062f \u0627\u0644\u0634\u0642\u064a\u0631\u064a\u061f", "context": "\u0623\u062d\u0645\u062f \u0645\u0627\u0632\u0646 \u0623\u062d\u0645\u062f \u0623\u0633\u0639\u062f \u0627\u0644\u0634\u0642\u064a\u0631\u064a (\u0648\u0644\u062f \u0641\u064a 6 \u064a\u0648\u0646\u064a\u0648 1973) \u0625\u0639\u0644\u0627\u0645\u064a \u0648\u0643\u0627\u062a\u0628 \u0633\u0639\u0648\u062f\u064a \u0648\u0645\u0642\u062f\u0645 \u0628\u0631\u0627\u0645\u062c \u062a\u0644\u0641\u0632\u064a\u0648\u0646\u064a\u0629"}], "datasets": ["google-research-datasets/tydiqa"], "license": "mit", "pipeline_tag": "question-answering"}, "likes": 0, "private": false, "downloads": 7, "tags": ["transformers", "safetensors", "bert", "question-answering", "ar", "dataset:google-research-datasets/tydiqa", "license:mit", "endpoints_compatible", "region:us"], "pipeline_tag": "question-answering", "library_name": "transformers", "createdAt": "2024-05-28T19:38:07.000Z", "modelId": "MostafaAhmed98/MARBERTv2-finetuned-ar-tydiqa"}, {"_id": "68337bb30db3675b7ea2f13c", "id": "a-xoda/technodoc_llm", "cardData": {"license": "unknown", "datasets": ["google-research-datasets/tydiqa"], "language": ["ru"], "base_model": ["google-bert/bert-base-multilingual-cased"], "pipeline_tag": "question-answering"}, "likes": 0, "private": false, "downloads": 6, "tags": ["safetensors", "bert", "question-answering", "ru", "dataset:google-research-datasets/tydiqa", "base_model:google-bert/bert-base-multilingual-cased", "base_model:finetune:google-bert/bert-base-multilingual-cased", "license:unknown", "region:us"], "pipeline_tag": "question-answering", "createdAt": "2025-05-25T20:21:07.000Z", "modelId": "a-xoda/technodoc_llm"}, {"_id": "68bbd973f7a01659adf95186", "id": "blaxx14/T5-Indonesian-QG", "cardData": {"library_name": "transformers", "datasets": ["google-research-datasets/tydiqa"], "language": ["id"], "metrics": ["bleu", "rouge"], "base_model": ["LazarusNLP/IndoNanoT5-base"], "pipeline_tag": "text-generation"}, "likes": 0, "private": false, "downloads": 5, "tags": ["transformers", "safetensors", "t5", "text2text-generation", "text-generation", "id", "dataset:google-research-datasets/tydiqa", "base_model:LazarusNLP/IndoNanoT5-base", "base_model:finetune:LazarusNLP/IndoNanoT5-base", "text-generation-inference", "endpoints_compatible", "region:us"], "pipeline_tag": "text-generation", "library_name": "transformers", "createdAt": "2025-09-06T06:49:23.000Z", "modelId": "blaxx14/T5-Indonesian-QG"}, {"_id": "665ca98d987f055eff893dea", "id": "philipp-zettl/t5-small-tydiqa-en", "cardData": {"library_name": "transformers", "datasets": ["google-research-datasets/tydiqa"], "license": "apache-2.0", "pipeline_tag": "text2text-generation", "base_model": "google/flan-t5-small", "widget": [{"text": "question: What is the huggingface hub? context: The Hugging Face Hub is a platform with over 350k models, 75k datasets, and 150k demo apps (Spaces), all open source and publicly available, in an online platform where people can easily collaborate and build ML together. The Hub works as a central place where anyone can explore, experiment, collaborate, and build technology with Machine Learning. Are you ready to join the path towards open source Machine Learning? \ud83e\udd17", "example_title": "\ud83e\udd17 Hub"}, {"text": "question: What is huggingface datasets? context: \ud83e\udd17 Datasets is a library for easily accessing and sharing datasets for Audio, Computer Vision, and Natural Language Processing (NLP) tasks. Load a dataset in a single line of code, and use our powerful data processing methods to quickly get your dataset ready for training in a deep learning model. Backed by the Apache Arrow format, process large datasets with zero-copy reads without any memory constraints for optimal speed and efficiency. We also feature a deep integration with the Hugging Face Hub, allowing you to easily load and share a dataset with the wider machine learning community. Find your dataset today on the Hugging Face Hub, and take an in-depth look inside of it with the live viewer.", "example_title": "\ud83e\udd17 datasets"}]}, "likes": 0, "private": false, "downloads": 4, "tags": ["transformers", "safetensors", "t5", "text2text-generation", "dataset:google-research-datasets/tydiqa", "arxiv:1910.09700", "base_model:google/flan-t5-small", "base_model:finetune:google/flan-t5-small", "license:apache-2.0", "text-generation-inference", "endpoints_compatible", "region:us"], "pipeline_tag": "text-generation", "library_name": "transformers", "createdAt": "2024-06-02T17:19:09.000Z", "modelId": "philipp-zettl/t5-small-tydiqa-en"}, {"_id": "66b31261f9194912cfea8d9e", "id": "Areeb123/Question_Answering", "cardData": {"library_name": "transformers", "tags": ["code"], "license": "mit", "datasets": ["google-research-datasets/tydiqa"], "language": ["en"], "metrics": ["accuracy"]}, "likes": 0, "private": false, "downloads": 3, "tags": ["transformers", "safetensors", "distilbert", "question-answering", "code", "en", "dataset:google-research-datasets/tydiqa", "license:mit", "endpoints_compatible", "region:us"], "pipeline_tag": "question-answering", "library_name": "transformers", "createdAt": "2024-08-07T06:21:21.000Z", "modelId": "Areeb123/Question_Answering"}]