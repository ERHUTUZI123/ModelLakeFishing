[{"_id": "6404e3bbdfde643e0615013c", "id": "kanishka/comps", "author": "kanishka", "disabled": false, "gated": false, "lastModified": "2023-09-16T15:09:24.000Z", "likes": 1, "trendingScore": 0, "private": false, "sha": "d182636c932e7628d53c74d48122b502b779ceec", "citation": "@article{misra2022comps,\n  title={COMPS: Conceptual Minimal Pair Sentences for testing Property Knowledge and Inheritance in Pre-trained Language Models},\n  author={Misra, Kanishka and Rayz, Julia Taylor and Ettinger, Allyson},\n  journal={arXiv preprint arXiv:2210.01963},\n  year={2022}\n}", "description": "COMPS is a dataset of minimal pair sentences in English that enables the \ntesting knowledge of concepts and their properties in language models (LMs).\nSpecifically, it tests the ability of LMs to attribute properties to everyday \nconcepts, and demonstrate reasoning compatible with property inheritance, where\nsubordinate concepts inherit the properties of their superordinate (hypernyms).", "downloads": 37, "tags": ["annotations_creators:expert-generated", "language_creators:machine-generated", "multilinguality:monolingual", "source_datasets:original", "language:en", "license:apache-2.0", "size_categories:100K<n<1M", "modality:tabular", "modality:text", "library:datasets", "library:mlcroissant", "arxiv:2210.01963", "region:us"], "createdAt": "2023-03-05T18:47:23.000Z", "key": ""}, {"_id": "647b3ae8b31514a4a6d81315", "id": "Branden28/CompSciQA", "author": "Branden28", "disabled": false, "gated": "auto", "lastModified": "2023-06-03T13:41:14.000Z", "likes": 0, "trendingScore": 0, "private": false, "sha": "e4b4e685b9bac514ae66b36c583488fbc80dc155", "downloads": 4, "tags": ["license:unknown", "size_categories:n<1K", "format:csv", "modality:text", "library:datasets", "library:pandas", "library:mlcroissant", "library:polars", "region:us"], "createdAt": "2023-06-03T13:06:48.000Z", "key": ""}, {"_id": "65825c2e2db4c45ef3f62cd4", "id": "netcat420/compsci", "author": "netcat420", "disabled": false,