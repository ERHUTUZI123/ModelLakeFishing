ets/jzhang86/corrected_ifeval.", "downloads": 17, "tags": ["license:apache-2.0", "size_categories:n<1K", "format:json", "modality:text", "library:datasets", "library:pandas", "library:mlcroissant", "library:polars", "region:us"], "createdAt": "2024-08-06T15:57:28.000Z", "key": ""}, {"_id": "66b248f57d134c780a1fa7a0", "id": "jzhang86/de_ifeval", "author": "jzhang86", "disabled": false, "gated": false, "lastModified": "2024-08-06T16:06:20.000Z", "likes": 1, "trendingScore": 0, "private": false, "sha": "4f52d847003b3c83cc282e9d296853a24b34b19a", "description": "German version of IFEVAL dataset based on jzhang86/corrected_ifeval\nGPT-4o is used for translation, every data point is human checked.\n", "downloads": 1032, "tags": ["license:apache-2.0", "size_categories:n<1K", "format:json", "modality:text", "library:datasets", "library:pandas", "library:mlcroissant", "library:polars", "region:us"], "createdAt": "2024-08-06T16:01:57.000Z", "key": ""}, {"_id": "66b2495e57f77ae547ef4763", "id": "jzhang86/es_ifeval", "author": "jzhang86", "disabled": false, "gated": false, "lastModified": "2024-08-06T16:06:38.000Z", "likes": 0, "trendingScore": 0, "private": false, "sha": "f7e4a618bcde27ce2ed85a2a969c09ac78ba2eb2", "description": "Spanish version of IFEVAL dataset based on jzhang86/corrected_ifeval\nGPT-4o is used for translation, every data point is human checked. \n", "downloads": 18, "tags": ["license:apache-2.0", "size_categories:n<1K", "format:json", "modality:text", "library:datasets", "library:pandas", "library:mlcroissant", "library:polars", "region:us"], "createdAt": "2024-08-06T16:03:42.000Z", "key": ""}]