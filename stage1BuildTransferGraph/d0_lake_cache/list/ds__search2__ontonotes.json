[{"_id": "62d29c0199febd9a27057d7f", "id": "tner/ontonotes5", "author": "tner", "disabled": false, "gated": false, "lastModified": "2022-07-18T00:43:55.000Z", "likes": 24, "private": false, "sha": "cf9ef57ad260810be1298ba795d83c09a915e959", "citation": "@inproceedings{hovy-etal-2006-ontonotes,\n    title = \"{O}nto{N}otes: The 90{\\%} Solution\",\n    author = \"Hovy, Eduard  and\n      Marcus, Mitchell  and\n      Palmer, Martha  and\n      Ramshaw, Lance  and\n      Weischedel, Ralph\",\n    booktitle = \"Proceedings of the Human Language Technology Conference of the {NAACL}, Companion Volume: Short Papers\",\n    month = jun,\n    year = \"2006\",\n    address = \"New York City, USA\",\n    publisher = \"Association for Computational Linguistics\",\n    url = \"https://aclanthology.org/N06-2015\",\n    pages = \"57--60\",\n}", "description": "[ontonotes5 NER dataset](https://aclanthology.org/N06-2015/)", "downloads": 1555, "tags": ["task_categories:token-classification", "task_ids:named-entity-recognition", "multilinguality:monolingual", "language:en", "license:other", "size_categories:10K<n<100K", "modality:text", "library:datasets", "library:mlcroissant", "region:us"], "createdAt": "2022-07-16T11:07:45.000Z", "key": ""}, {"_id": "62306efca7ea9e7951f54927", "id": "ontonotes/conll2012_ontonotesv5", "author": "ontonotes", "disabled": false, "gated": false, "lastModified": "2024-01-18T09:34:57.000Z", "likes": 45, "private": false, "sha": "1161216f7e7185a4b2f4d0a4e0734dc7919dfa15", "citation": "@inproceedings{pradhan-etal-2013-towards,\n    title = \"Towards Robust Linguistic Analysis using {O}nto{N}otes\",\n    author = {Pradhan, Sameer  and\n      Moschitti, Alessandro  and\n      Xue, Nianwen  and\n      Ng, Hwee Tou  and\n      Bj{\\\"o}rkelund, Anders  and\n      Uryupina, Olga  and\n      Zhang, Yuchen  and\n      Zhong, Zhi},\n    booktitle = \"Proceedings of the Seventeenth Conference on Computational Natural Language Learning\",\n    month = aug,\n    year = \"2013\",\n    address = \"Sofia, Bulgaria\",\n    publisher = \"Association for Computational Linguistics\",\n    url = \"https://aclanthology.org/W13-3516\",\n    pages = \"143--152\",\n}\n\nRalph Weischedel, Martha Palmer, Mitchell Marcus, Eduard Hovy, Sameer Pradhan, Lance Ramshaw, Nianwen Xue, Ann Taylor, Jeff Kaufman, Michelle Franchini, Mohammed El-Bachouti, Robert Belvin, Ann Houston. OntoNotes Release 5.0 LDC2013T19. Web Download. Philadelphia: Linguistic Data Consortium, 2013.", "description": "OntoNotes v5.0 is the final version of OntoNotes corpus, and is a large-scale, multi-genre,\nmultilingual corpus manually annotated with syntactic, semantic and discourse information.\n\nThis dataset is the version of OntoNotes v5.0 extended and is used in the CoNLL-2012 shared task.\nIt includes v4 train/dev and v9 test data for English/Chinese/Arabic and corrected version v12 train/dev/test data (English only).\n\nThe source of data is the Mendeley Data repo [ontonotes-conll2012](https://data.mendeley.com/datasets/zmycy7t9h9), which seems to be as the same as the official data, but users should use this dataset on their own responsibility.\n\nSee also summaries from paperwithcode, [OntoNotes 5.0](https://paperswithcode.com/dataset/ontonotes-5-0) and [CoNLL-2012](https://paperswithcode.com/dataset/conll-2012-1)\n\nFor more detailed info of the dataset like annotation, tag set, etc., you can refer to the documents in the Mendeley repo mentioned above.", "downloads": 1060, "paperswithcode_id": "ontonotes-5-0", "tags": ["task_categories:token-classification", "task_ids:named-entity-recognition", "task_ids:part-of-speech", "task_ids:coreference-resolution", "task_ids:parsing", "task_ids:lemmatization", "task_ids:word-sense-disambiguation", "annotations_creators:expert-generated", "language_creators:found", "multilinguality:multilingual", "source_datasets:original", "language:ar", "language:en", "language:zh", "license:cc-by-nc-nd-4.0", "size_categories:10K<n<100K", "region:us", "semantic-role-labeling"], "createdAt": "2022-03-15T10:48:28.000Z", "key": ""}, {"_id": "645bea1c8bbb8592d91a59f2", "id": "arubenruben/ontonotes5.0-pt-harem-selective", "author": "arubenruben", "disabled": false, "gated": false, "lastModified": "2023-05-12T10:02:20.000Z", "likes": 0, "private": false, "sha": "1531f0922670725d9ff9cc51c9fce40b6f50a828", "description": "\n\t\n\t\t\n\t\tDataset Card for \"ontonotes5.0-pt-harem-selective\"\n\t\n\nMore Information needed\n", "downloads": 212, "tags": ["size_categories:1K<n<10K", "format:parquet", "modality:text", "library:datasets", "library:pandas", "library:mlcroissant", "library:polars", "region:us"], "createdAt": "2023-05-10T19:01:48.000Z", "key": ""}, {"_id": "62bb3ba6376a8a369f1a26b0", "id": "SpeedOfMagic/ontonotes_english", "author": "SpeedOfMagic", "disabled": false, "gated": false, "lastModified": "2022-07-01T16:06:06.000Z", "likes": 3, "private": false, "sha": "8b4000d7a1e7779bd0c7291f785a2160f95c03fb", "description": "\n\t\n\t\t\n\t\tDataset Card for ontonotes_english\n\t\n\n\n\t\n\t\t\n\t\tDataset Summary\n\t\n\nThis is preprocessed version of what I assume is OntoNotes v5.0.\nInstead of having sentences stored in files, files are unpacked and sentences are the rows now. Also, fields were renamed in order to match conll2003.\nThe source of data is from private repository, which in turn got data from another public repository, location of which is unknown :)\nSince data from all repositories had no license (creator of the private\u2026 See the full description on the dataset page: https://huggingface.co/datasets/SpeedOfMagic/ontonotes_english.", "downloads": 192, "tags": ["task_categories:token-classification", "task_ids:named-entity-recognition", "annotations_creators:found", "language_creators:found", "multilinguality:monolingual", "source_datasets:extended|other", "language:en", "license:unknown", "size_categories:10K<n<100K", "format:parquet", "modality:text", "library:datasets", "library:pandas", "library:mlcroissant", "library:polars", "region:us"], "createdAt": "2022-06-28T17:34:30.000Z", "key": ""}, {"_id": "64b011f341bfde6fc53ea11b", "id": "DFKI-SLT/conll2012_ontonotesv5", "author": "DFKI-SLT", "disabled": false, "gated": false, "lastModified": "2023-07-13T15:02:27.000Z", "likes": 0, "private": false, "sha": "df483c66c395645d152cf57e2b836d390580f0c4", "citation": "@inproceedings{pradhan-etal-2013-towards,\n    title = \"Towards Robust Linguistic Analysis using {O}nto{N}otes\",\n    author = {Pradhan, Sameer  and\n      Moschitti, Alessandro  and\n      Xue, Nianwen  and\n      Ng, Hwee Tou  and\n      Bj{\\\"o}rkelund, Anders  and\n      Uryupina, Olga  and\n      Zhang, Yuchen  and\n      Zhong, Zhi},\n    booktitle = \"Proceedings of the Seventeenth Conference on Computational Natural Language Learning\",\n    month = aug,\n    year = \"2013\",\n    address = \"Sofia, Bulgaria\",\n    publisher = \"Association for Computational Linguistics\",\n    url = \"https://aclanthology.org/W13-3516\",\n    pages = \"143--152\",\n}\n\nRalph Weischedel, Martha Palmer, Mitchell Marcus, Eduard Hovy, Sameer Pradhan, Lance Ramshaw, Nianwen Xue, Ann Taylor, Jeff Kaufman, Michelle Franchini, Mohammed El-Bachouti, Robert Belvin, Ann Houston. OntoNotes Release 5.0 LDC2013T19. Web Download. Philadelphia: Linguistic Data Consortium, 2013.", "description": "OntoNotes v5.0 is the final version of OntoNotes corpus, and is a large-scale, multi-genre,\nmultilingual corpus manually annotated with syntactic, semantic and discourse information.\n\nThis dataset is the version of OntoNotes v5.0 extended and is used in the CoNLL-2012 shared task.\nIt includes v4 train/dev and v9 test data for English/Chinese/Arabic and corrected version v12 train/dev/test data (English only).\n\nThe source of data is the Mendeley Data repo [ontonotes-conll2012](https://data.mendeley.com/datasets/zmycy7t9h9), which seems to be as the same as the official data, but users should use this dataset on their own responsibility.\n\nSee also summaries from paperwithcode, [OntoNotes 5.0](https://paperswithcode.com/dataset/ontonotes-5-0) and [CoNLL-2012](https://paperswithcode.com/dataset/conll-2012-1)\n\nFor more detailed info of the dataset like annotation, tag set, etc., you can refer to the documents in the Mendeley repo mentioned above.", "downloads": 126, "tags": ["region:us"], "createdAt": "2023-07-13T15:02:11.000Z", "key": ""}, {"_id": "62c15b92e181094cdad980e4", "id": "djagatiya/ner-ontonotes-v5-eng-v4", "author": "djagatiya", "disabled": false, "gated": false, "lastModified": "2022-07-03T11:36:33.000Z", "likes": 1, "private": false, "sha": "944fe3f43c298ca526eeb51927210795ab4721a0", "description": "\n\t\n\t\t\n\t\t(NER) ontonotes-v5-eng-v4\n\t\n\nThis dataset is subset of conll2012_ontonotesv5 original dataset.\n\nLanguage: english\nVersion: v4\n\n\n\t\n\t\t\nDataset\nExamples\n\n\n\t\t\nTraining\n75187\n\n\nTesting\n9479\n\n\n\t\n\n", "downloads": 125, "tags": ["task_categories:token-classification", "task_ids:named-entity-recognition", "source_datasets:subset", "language:eng", "region:us"], "createdAt": "2022-07-03T09:04:18.000Z", "key": ""}, {"_id": "6a475cdc9b0cf165ea7d58e1", "id": "quynong/ontonotes5", "author": "quynong", "disabled": false, "gated": false, "lastModified": "2026-07-03T06:55:33.000Z", "likes": 0, "private": false, "sha": "020798e2282aa83a4c1eec10ab088f3960faae15", "downloads": 83, "tags": ["region:us"], "createdAt": "2026-07-03T06:55:24.000Z", "key": ""}, {"_id": "64b5199725882acb62fb78d2", "id": "pie/conll2012_ontonotesv5", "author": "pie", "disabled": false, "gated": false, "lastModified": "2025-09-24T15:37:56.000Z", "likes": 1, "private": false, "sha": "be85b0b0cdd7a85d5399006e49e719675f6b1e93", "description": "\n\t\n\t\t\n\t\tPIE Dataset Card for CoNLL2012 shared task data based on OntoNotes 5.0\n\t\n\nThis is a PyTorch-IE (PIE) wrapper for the\nCoNLL 2012 OntoNotes v.5.0 Huggingface dataset loading script.\n\n\t\n\t\t\n\t\tDataset Variants\n\t\n\nThis dataset contains data in three languages and two versions:\n\narabic_v4\nchinese_v4\nenglish_v4\nenglish_v12\n\n\n\t\n\t\t\n\t\tData Schema\n\t\n\nThe document type for this dataset is Conll2012OntonotesV5Document which defines the following data fields:\n\nid (str)\ntokens (tuple)\npos_tags (list)\u2026 See the full description on the dataset page: https://huggingface.co/datasets/pie/conll2012_ontonotesv5.", "downloads": 71, "tags": ["region:us"], "createdAt": "2023-07-17T10:36:07.000Z", "key": ""}, {"_id": "6773ae2417d534465f86ae78", "id": "DGME/ontonotes", "author": "DGME", "disabled": false, "gated": false, "lastModified": "2024-12-31T11:23:52.000Z", "likes": 0, "private": false, "sha": "a9d61f7698822ec9f8b421a2bb2078e3909c8648", "downloads": 53, "tags": ["license:mit", "size_categories:100K<n<1M", "format:parquet", "modality:text", "library:datasets", "library:pandas", "library:mlcroissant", "library:polars", "region:us"], "createdAt": "2024-12-31T08:41:08.000Z", "key": ""}, {"_id": "6a4bc806e52d8aa38761e4ec", "id": "AITeamUIT/eval-gliner2-ner-ontonotes5-focal-20260706", "author": "AITeamUIT", "disabled": false, "gated": false, "lastModified": "2026-07-06T15:21:42.000Z", "likes": 0, "private": false, "sha": "b64cf4ed793a4581f5fbb67e15d33fbd62ba1e25", "downloads": 39, "tags": ["region:us"], "createdAt": "2026-07-06T15:21:42.000Z", "key": ""}, {"_id": "6a4c15e8642c8debd75e4e58", "id": "AITeamUIT/eval-gliner2-ner-ontonotes5-focal-eiou-20260706", "author": "AITeamUIT", "disabled": false, "gated": false, "lastModified": "2026-07-06T20:54:01.000Z", "likes": 0, "private": false, "sha": "26f62a4c31cda6264e7d9233830e794eab5a0f6f", "downloads": 38, "tags": ["region:us"], "createdAt": "2026-07-06T20:54:00.000Z", "key": ""}, {"_id": "6a4ba8a51c7e1a87c9080e53", "id": "AITeamUIT/eval-gliner2-ner-ontonotes5-bce-20260706", "author": "AITeamUIT", "disabled": false, "gated": false, "lastModified": "2026-07-06T14:49:42.000Z", "likes": 0, "private": false, "sha":