[{"_id": "6a56787c6b2f45280b6439ec", "id": "yulivvv/toxic-text-classification-ru", "author": "yulivvv", "disabled": false, "gated": false, "lastModified": "2026-07-15T08:09:33.000Z", "likes": 1, "trendingScore": 1, "private": false, "sha": "97c8ba1edde99cf67e308e8265fe3060e1244e22", "description": "\n\t\n\t\t\n\t\n\t\n\t\tRussian Toxic Text Classification Dataset\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\t\u041e\u043f\u0438\u0441\u0430\u043d\u0438\u0435\n\t\n\n\u0414\u0430\u0442\u0430\u0441\u0435\u0442 \u043f\u0440\u0435\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d \u0434\u043b\u044f \u0437\u0430\u0434\u0430\u0447\u0438 \u0431\u0438\u043d\u0430\u0440\u043d\u043e\u0439 \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0438 \u0440\u0443\u0441\u0441\u043a\u043e\u044f\u0437\u044b\u0447\u043d\u044b\u0445 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\n\u043f\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u043a\u0443 \u0442\u043e\u043a\u0441\u0438\u0447\u043d\u043e\u0441\u0442\u0438.\n\u0426\u0435\u043b\u044c \u2014 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u0442\u044c, \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043b\u0438 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0442\u043e\u043a\u0441\u0438\u0447\u043d\u044b\u043c \u0438\u043b\u0438 \u043d\u0435\u0442\u043e\u043a\u0441\u0438\u0447\u043d\u044b\u043c.\n\n\t\n\t\t\n\t\n\t\n\t\t\u0424\u043e\u0440\u043c\u0430\u0442 \u0434\u0430\u043d\u043d\u044b\u0445\n\t\n\n\u041a\u0430\u0436\u0434\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u0434\u0432\u0430 \u043f\u043e\u043b\u044f:\n\ntext \u2014 \u0442\u0435\u043a\u0441\u0442 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f;\nlabel \u2014 \u0431\u0438\u043d\u0430\u0440\u043d\u0430\u044f \u043c\u0435\u0442\u043a\u0430 \u043a\u043b\u0430\u0441\u0441\u0430.\n\n\u0417\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043c\u0435\u0442\u043a\u0438:\n\n0 \u2014 \u043d\u0435\u0442\u043e\u043a\u0441\u0438\u0447\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442;\n1 \u2014 \u0442\u043e\u043a\u0441\u0438\u0447\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442.\n\n\n\t\n\t\t\n\t\n\t\n\t\t\u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u0434\u0430\u043d\u043d\u044b\u0445\n\t\n\n\n\t\n\t\t\n\t\n\t\n\t\t\u0422\u043e\u043a\u0441\u0438\u0447\u043d\u044b\u0439 \u043a\u043b\u0430\u0441\u0441 (label\u2026 See the full description on the dataset page: https://huggingface.co/datasets/yulivvv/toxic-text-classification-ru.", "downloads": 47, "tags": ["size_categories:10K<n<100K", "format:parquet", "modality:text", "library:datasets", "library:pandas", "library:polars", "library:mlcroissant", "region:us"], "createdAt": "2026-07-14T17:57:16.000Z", "key": ""}, {"_id": "621ffdd236468d709f1824ab", "id": "Karavet/ILUR-news-text-classification-corpus", "author": "Karavet", "disabled": false, "gated": false, "lastModified": "2022-10-21T16:06:12.000Z", "likes": 2, "trendingScore": 0, "private": false, "sha": "2fda001dd651936d4ec71e9a6c9a6b828d752f3c", "description": "\n\t\n\t\t\n\t\tNews Texts Dataset\n\t\n\nWe release a dataset of over 12000 news articles from iLur.am, categorized into 7 classes: sport, politics, weather, economy, accidents, art, society. The articles are split into train (2242k tokens) and test sets (425k tokens).\nFor more details, refer to the paper.\n", "downloads": 282, "tags": ["task_categories:text-classification", "multilinguality:monolingual", "language:hy", "license:apache-2.0", "size_categories:100K<n<1M", "format:text", "modality:text", "library:datasets", "library:mlcroissant", "region:us"], "createdAt": "2022-03-02T23:29:22.000Z", "key": ""}, {"_id": "621ffdd236468d709f183651", "id": "jakeazcona/short-text-labeled-emotion-classification", "author": "jakeazcona", "disabled": false, "gated": false, "lastModified": "2021-12-05T18:38:57.000Z", "likes": 2, "trendingScore": 0, "private": false, "sha": "790c108d5eafbf27b8605c598e096e16e80009df", "downloa