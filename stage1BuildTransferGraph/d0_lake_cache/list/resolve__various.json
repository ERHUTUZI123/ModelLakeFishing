: ""}, {"_id": "65af38f301b6f61e2490a2f2", "id": "JoinDatawithme/Humanface_of_various_age_groups", "author": "JoinDatawithme", "disabled": false, "gated": false, "lastModified": "2024-01-23T04:33:16.000Z", "likes": 3, "trendingScore": 0, "private": false, "sha": "b0c674b8a898fc213cb908494d456352bbb10468", "description": "\ud83d\udcda Dataset Introduction\n\u00b7 This dataset is constructed with generated data and contains a total of 1000 human face images with a resolution of 1024x1024.\n\u00b7 The filenames are the corresponding labels for the images, formatted as \"Number\"-\"Gender\"-\"Age\".\n\u00b7 The dataset includes 500 images of each gender, distributed across different age groups (1-10, 11-20, 21-30, 31-40, over 40) with 100 images for each group.\nThis dataset is a sample of 1000 images from the full collection.\nFor more data\u2026 See the full description on the dataset page: https://huggingface.co/datasets/JoinDatawithme/Humanface_of_various_age_groups.", "downloads": 40, "tags": ["language:en", "license:apache-2.0", "size_categories:1K<n<10K", "format:imagefolder", "modality:image", "modality:text", "library:datasets", "library:mlcroissant", "region:us", "face", "humanface", "ml", "face recognition", "Generated data", "dataset"], "createdAt": "2024-01-23T03:56:35.000Z", "key": ""}, {"_id": "65ddde5f010feb93b5d180d0", "id": "ChuckMcSneed/various_RP_system_prompts", "author": "ChuckMcSneed", "disabled": false, "gated": false, "lastModified": "2024-09-15T19:03:27.000Z", "likes": 23, "trendingScore": 0, "private": false, "sha": "fb4009fad3195bc739b4205bd7ed6af56f2d5589", "description": "Collection of various system prompts for RP. Feel free to contribute more by opening a discussion.\nChuckMcSneed-interesting:\n\nmy currently favorite system prompt\nincludes Orwells writing rules\n+writes in non-boring style\n+more realistic reactions\n+eliminates a lot of GPTslop\n-writing style is not for everyone\n-complains more, but still does what is requested\n-sometimes reddit-like\n\nChuckMcSneed-multistyle\n\nList of various styles\nAll of them tested with examples\nRanges from good to shit\u2026 See the full description on the dataset page: https://huggingface.co/datasets/ChuckMcSneed/various_RP_system_prompts.", "downloads": 29, "tags": ["size_categories:1K<n<10K", "format:text", "modality:text", "library:datasets", "library:mlcroissant", "region:us", "not-for-all-audiences", "nsfw", "system-prompts", "RP"], "createdAt": "2024-02-27T13:06:39.000Z", "key": ""}]