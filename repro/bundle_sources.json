      ],
      "copies": [
        {"from": "data1m/final_system/seed_0/model_ids.parquet", "to": "data1m/final_system/seed_1/model_ids.parquet"},
        {"from": "data1m/final_system/seed_0/model_ids.parquet", "to": "data1m/final_system/seed_2/model_ids.parquet"},
        {"from": "data1m/final_system/seed_0/dataset_ids.parquet", "to": "data1m/final_system/seed_1/dataset_ids.parquet"},
        {"from": "data1m/final_system/seed_0/dataset_ids.parquet", "to": "data1m/final_system/seed_2/dataset_ids.parquet"}
