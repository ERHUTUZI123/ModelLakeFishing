{
  "schema_version": 1,
  "bundles": {
    "inputs-3m-v1": {
      "description": "Frozen metadata snapshots and source evidence required for a full rebuild.",
      "files": [
        {
          "root": "data",
          "source": "data1m/candidates_full",
          "target": "data1m/candidates_full",
          "include": ["CURSOR.json", "PROVENANCE.json", "SHARDS.json", "hf_models_*.jsonl.gz"]
        },
        {
          "root": "data",
          "source": "data1m/datasets_full",
          "target": "data1m/datasets_full",
          "include": ["CURSOR.json", "PROVENANCE.json", "SHARDS.json", "hf_models_*.jsonl.gz"]
        },
        {"root": "repo", "source": "stage1BuildTransferGraph/hgraph_ml_v2.pt", "target": "data1m/source_evidence/hgraph_ml_v2.pt"},
        {"root": "repo", "source": "stage1BuildTransferGraph/hgraph_d05_nocontent.pt", "target": "data1m/source_evidence/hgraph_d05_nocontent.pt"},
        {"root": "repo", "source": "stage1BuildTransferGraph/hgraph_A_ctrl_2000m_xm0_xd0.pt", "target": "data1m/source_evidence/hgraph_A_ctrl_2000m_xm0_xd0.pt"},
        {"root": "repo", "source": "stage1BuildTransferGraph/hgraph_hf_effective_2000m_v2_xm0_xd0.pt", "target": "data1m/source_evidence/hgraph_hf_effective_2000m_v2_xm0_xd0.pt"},
        {"root": "repo", "source": "stage1BuildTransferGraph/hgraph_diverse_xd0.pt", "target": "data1m/source_evidence/hgraph_diverse_xd0.pt"}
      ]
    },
    "paper-3m-v1": {
