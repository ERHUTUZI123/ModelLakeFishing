      "files": [
        {"root": "data", "source": "data1m/exports_x4/X4GD_full_s0_e25/model_ids.parquet", "target": "data1m/final_system/seed_0/model_ids.parquet"},
        {"root": "data", "source": "data1m/exports_x4/X4GD_full_s0_e25/dataset_ids.parquet", "target": "data1m/final_system/seed_0/dataset_ids.parquet"},
