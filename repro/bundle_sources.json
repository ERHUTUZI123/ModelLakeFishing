        {"root": "data", "source": "data1m/exports_x4/X4GD_full_s0_e25/gold_cands.npz", "target": "data1m/final_system/seed_0/gold_candidates.npz"},
        {"root": "data", "source": "data1m/exports_x4/X4GD_full_s0_e25/z_d_eval.npy", "target": "data1m/final_system/seed_0/query_embeddings.npy"},
        {"root": "data", "source": "data1m/exports_x4/X4GD_full_s0_e25/hnsw_y2_eval.bin", "target": "data1m/final_system/seed_0/hnsw_top1000.bin"},
        {"root": "data", "source": "data1m/exports_rf/RF_full_s0_e25/prior_sidecar_s0.npz", "target": "data1m/final_system/seed_0/task_prior.npz"},
        {"root": "data", "source": "data1m/exports_rf/RF_full_s0_e25/prior_sidecar_s0_meta.json", "target": "data1m/final_system/seed_0/task_prior_meta.json"},
        {"root": "data", "source": "data1m/exports_x4/X4GD_full_s1_e25/gold_cands.npz", "target": "data1m/final_system/seed_1/gold_candidates.npz"},
        {"root": "data", "source": "data1m/exports_x4/X4GD_full_s1_e25/z_d_eval.npy", "target": "data1m/final_system/seed_1/query_embeddings.npy"},
        {"root": "data", "source": "data1m/exports_x4/X4GD_full_s1_e25/hnsw_y2_eval.bin", "target": "data1m/final_system/seed_1/hnsw_top1000.bin"},
        {"root": "data", "source": "data1m/exports_rf/RF_full_s1_e25/prior_sidecar_s1.npz", "target": "data1m/final_system/seed_1/task_prior.npz"},
        {"root": "data", "source": "data1m/exports_rf/RF_full_s1_e25/prior_sidecar_s1_meta.json", "target": "data1m/final_system/seed_1/task_prior_meta.json"},
        {"root": "data", "source": "data1m/exports_x4/X4GD_full_s2_e25/gold_cands.npz", "target": "data1m/final_system/seed_2/gold_candidates.npz"},
        {"root": "data", "source": "data1m/exports_x4/X4GD_full_s2_e25/z_d_eval.npy", "target": "data1m/final_system/seed_2/query_embeddings.npy"},
