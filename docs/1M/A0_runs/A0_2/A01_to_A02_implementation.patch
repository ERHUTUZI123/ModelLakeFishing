+    save("hnsw_a0_s0.bin")
+    manifest["seeds"]["0"] = {"exact": "a0_exact_s0.npz", "hnsw": "a0_hnsw_s0.npz",
+                                "calibration": ["a0_calibration_s0_ef1000.npz"], "index": "hnsw_a0_s0.bin",
+                                "index_build": {"start_ns": 1000, "end_ns": 2000001000, "build_seconds": 2.0},
