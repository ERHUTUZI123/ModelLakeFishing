+               contrast_n_neg=args.contrast_n_neg,
+               contrast_max_pos_per_dataset=args.contrast_max_pos_per_dataset,
+               infer_chunk=args.chunked_infer,
+               skip_diagnostics=args.skip_diagnostics)
+    if args.batch_size:
+        cfg["batch_size"] = args.batch_size
+    return cfg
